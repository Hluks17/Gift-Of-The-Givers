@{
    ViewData["Title"] = "Employee Dashboard";
}

<div class="container-fluid mt-4 mb-5">

    <!-- Header -->
    <div class="row mb-4">

        <div class="col">

            <div class="card shadow border-0">

                <div class="card-body p-4">

                    <h1 class="text-success fw-bold">
                        Employee Dashboard
                    </h1>

                    <p class="text-muted mb-0">
                        Manage humanitarian activities,
                        volunteers, donations and relief requests.
                    </p>

                </div>

            </div>

        </div>

    </div>


    <!-- Statistics -->
    <div class="row g-4 mb-5">

        <!-- Donations -->
        <div class="col-md-3">

            <div class="card shadow border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <p class="text-muted mb-1">
                                Total Donations
                            </p>

                            <h2 class="fw-bold text-success">
                                R125,450
                            </h2>

                        </div>

                        <div class="display-6">
                            💰
                        </div>

                    </div>

                    <p class="text-success mb-0">
                        Prototype data
                    </p>

                </div>

            </div>

        </div>


        <!-- Volunteers -->
        <div class="col-md-3">

            <div class="card shadow border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <p class="text-muted mb-1">
                                Volunteers
                            </p>

                            <h2 class="fw-bold text-success">
                                248
                            </h2>

                        </div>

                        <div class="display-6">
                            🤝
                        </div>

                    </div>

                    <p class="text-success mb-0">
                        Registered volunteers
                    </p>

                </div>

            </div>

        </div>


        <!-- Relief Requests -->
        <div class="col-md-3">

            <div class="card shadow border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <p class="text-muted mb-1">
                                Relief Requests
                            </p>

                            <h2 class="fw-bold text-warning">
                                17
                            </h2>

                        </div>

                        <div class="display-6">
                            🚨
                        </div>

                    </div>

                    <p class="text-warning mb-0">
                        Require attention
                    </p>

                </div>

            </div>

        </div>


        <!-- Users -->
        <div class="col-md-3">

            <div class="card shadow border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <p class="text-muted mb-1">
                                System Users
                            </p>

                            <h2 class="fw-bold text-success">
                                532
                            </h2>

                        </div>

                        <div class="display-6">
                            👥
                        </div>

                    </div>

                    <p class="text-success mb-0">
                        Registered accounts
                    </p>

                </div>

            </div>

        </div>

    </div>


    <!-- Management -->
    <h3 class="text-success fw-bold mb-3">
        Management
    </h3>

    <div class="row g-4">

        <!-- Donations -->
        <div class="col-md-6 col-lg-3">

            <div class="card shadow border-0 h-100">

                <div class="card-body text-center p-4">

                    <div class="display-5 mb-3">
                        💰
                    </div>

                    <h4>
                        Donations
                    </h4>

                    <p class="text-muted">
                        View and manage donation records.
                    </p>

                    <a asp-controller="Employee"
                       asp-action="Donations"
                       class="btn btn-success">

                        Manage Donations

                    </a>

                </div>

            </div>

        </div>


        <!-- Volunteers -->
        <div class="col-md-6 col-lg-3">

            <div class="card shadow border-0 h-100">

                <div class="card-body text-center p-4">

                    <div class="display-5 mb-3">
                        🤝
                    </div>

                    <h4>
                        Volunteers
                    </h4>

                    <p class="text-muted">
                        View registered volunteers and
                        their skills.
                    </p>

                    <a asp-controller="Employee"
                       asp-action="Volunteers"
                       class="btn btn-success">

                        Manage Volunteers

                    </a>

                </div>

            </div>

        </div>


        <!-- Relief -->
        <div class="col-md-6 col-lg-3">

            <div class="card shadow border-0 h-100">

                <div class="card-body text-center p-4">

                    <div class="display-5 mb-3">
                        🚨
                    </div>

                    <h4>
                        Relief Requests
                    </h4>

                    <p class="text-muted">
                        Review humanitarian assistance
                        requests.
                    </p>

                    <a asp-controller="Employee"
                       asp-action="ReliefRequests"
                       class="btn btn-success">

                        View Requests

                    </a>

                </div>

            </div>

        </div>


        <!-- Users -->
        <div class="col-md-6 col-lg-3">

            <div class="card shadow border-0 h-100">

                <div class="card-body text-center p-4">

                    <div class="display-5 mb-3">
                        👥
                    </div>

                    <h4>
                        Users
                    </h4>

                    <p class="text-muted">
                        Manage registered system users.
                    </p>

                    <a asp-controller="Employee"
                       asp-action="Users"
                       class="btn btn-success">

                        Manage Users

                    </a>

                </div>

            </div>

        </div>

    </div>


    <!-- Recent Activity -->
    <div class="card shadow border-0 mt-5">

        <div class="card-body p-4">

            <h3 class="text-success fw-bold mb-4">
                Recent Activity
            </h3>

            <div class="table-responsive">

                <table class="table table-hover">

                    <thead class="table-success">

                        <tr>
                            <th>Activity</th>
                            <th>User</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>

                    </thead>

                    <tbody>

                        <tr>
                            <td>Donation Received</td>
                            <td>Anonymous</td>
                            <td>Today</td>
                            <td>
                                <span class="badge bg-success">
                                    Completed
                                </span>
                            </td>
                        </tr>

                        <tr>
                            <td>Volunteer Registration</td>
                            <td>Test Volunteer</td>
                            <td>Today</td>
                            <td>
                                <span class="badge bg-primary">
                                    New
                                </span>
                            </td>
                        </tr>

                        <tr>
                            <td>Relief Request</td>
                            <td>Community A</td>
                            <td>Yesterday</td>
                            <td>
                                <span class="badge bg-warning text-dark">
                                    Pending
                                </span>
                            </td>
                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- Return -->
    <div class="text-center mt-4">

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-outline-success me-2">

            Return to Website

        </a>


        <a asp-controller="Employee"
           asp-action="Logout"
           class="btn btn-outline-danger">

            Logout

        </a>

    </div>

</div>