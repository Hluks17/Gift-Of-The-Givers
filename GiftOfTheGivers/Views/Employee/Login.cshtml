@model GiftOfTheGivers.Models.EmployeeLoginViewModel

@{
    ViewData["Title"] = "Employee Login";
}

<div class="container mt-5 mb-5">

    <div class="row justify-content-center">

        <div class="col-md-6 col-lg-5">

            <div class="card shadow border-0">

                <div class="card-body p-4 p-md-5">

                    <!-- Header -->

                    <div class="text-center mb-4">

                        <div class="display-4 mb-3">
                            👨‍💼
                        </div>

                        <h1 class="text-success fw-bold">
                            Employee Login
                        </h1>

                        <p class="text-muted">
                            Access the Gift of the Givers
                            employee management system.
                        </p>

                    </div>


                    <!-- Login Form -->

                    <form asp-controller="Employee"
                          asp-action="Login"
                          method="post">


                        <!-- General Error -->

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <!-- Email -->

                        <div class="mb-3">

                            <label asp-for="Email"
                                   class="form-label fw-bold">

                                Employee Email

                            </label>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control form-control-lg"
                                   placeholder="employee@giftofthegivers.org" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Password -->

                        <div class="mb-3">

                            <label asp-for="Password"
                                   class="form-label fw-bold">

                                Password

                            </label>

                            <input asp-for="Password"
                                   type="password"
                                   class="form-control form-control-lg"
                                   placeholder="Enter your password" />

                            <span asp-validation-for="Password"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Remember Me -->

                        <div class="form-check mb-4">

                            <input asp-for="RememberMe"
                                   class="form-check-input" />

                            <label asp-for="RememberMe"
                                   class="form-check-label">

                                Remember me

                            </label>

                        </div>


                        <!-- Prototype Notice -->

                        <div class="alert alert-warning">

                            <strong>Prototype Employee Login</strong>

                            <p class="mb-0 mt-2">
                                Database authentication will be
                                added later.
                            </p>

                        </div>


                        <!-- Login Button -->

                        <button type="submit"
                                class="btn btn-success btn-lg w-100">

                            Login to Employee Dashboard

                        </button>

                    </form>


                    <!-- Back to Website -->

                    <div class="text-center mt-4">

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="text-success">

                            ← Back to main website

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}