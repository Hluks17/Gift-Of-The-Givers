@model GiftOfTheGivers.Models.Donation

@{
    ViewData["Title"] = "Donate";
}

<div class="container mt-5 mb-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow border-0">

                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">

                        <h1 class="text-success fw-bold">
                            Make a Donation
                        </h1>

                        <p class="text-muted">
                            Your support helps humanitarian relief
                            efforts reach communities in need.
                        </p>

                    </div>


                    <form asp-controller="Donation"
                          asp-action="Create"
                          method="post">


                        <!-- Donor Name -->
                        <div class="mb-3">

                            <label asp-for="DonorName"
                                   class="form-label fw-bold">
                                Donor Name
                            </label>

                            <input asp-for="DonorName"
                                   class="form-control"
                                   placeholder="Leave blank for anonymous donation" />

                            <div class="form-text">
                                You may leave this blank to donate anonymously.
                            </div>

                        </div>


                        <!-- Email -->
                        <div class="mb-3">

                            <label asp-for="DonorEmail"
                                   class="form-label fw-bold">
                                Email Address
                            </label>

                            <input asp-for="DonorEmail"
                                   type="email"
                                   class="form-control"
                                   placeholder="example@email.com" />

                        </div>


                        <!-- Amount -->
                        <div class="mb-3">

                            <label asp-for="Amount"
                                   class="form-label fw-bold">
                                Donation Amount
                            </label>

                            <input asp-for="Amount"
                                   type="number"
                                   step="0.01"
                                   min="1"
                                   class="form-control"
                                   placeholder="Enter amount" />

                            <span asp-validation-for="Amount"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Currency -->
                        <div class="mb-3">

                            <label asp-for="Currency"
                                   class="form-label fw-bold">
                                Currency
                            </label>

                            <select asp-for="Currency"
                                    class="form-select">

                                <option value="ZAR">
                                    South African Rand (ZAR)
                                </option>

                                <option value="USD">
                                    US Dollar (USD)
                                </option>

                                <option value="EUR">
                                    Euro (EUR)
                                </option>

                                <option value="GBP">
                                    British Pound (GBP)
                                </option>

                            </select>

                        </div>


                        <!-- Donation Type -->
                        <div class="mb-4">

                            <label asp-for="DonationType"
                                   class="form-label fw-bold">
                                Donation Type
                            </label>

                            <select asp-for="DonationType"
                                    class="form-select">

                                <option value="One-Time">
                                    One-Time Donation
                                </option>

                                <option value="Recurring">
                                    Recurring Donation
                                </option>

                            </select>

                        </div>


                        <!-- Prototype Notice -->
                        <div class="alert alert-info">

                            <strong>Prototype Notice:</strong>

                            <br />

                            This prototype demonstrates the donation
                            process. No real payment will be processed.

                        </div>


                        <!-- Submit -->
                        <button type="submit"
                                class="btn btn-success btn-lg w-100">

                            Submit Donation

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}