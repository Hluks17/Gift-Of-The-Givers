@{
    ViewData["Title"] = "Manage Donations";
}

<div class="container mt-5 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h1 class="text-success fw-bold">
                Manage Donations
            </h1>

            <p class="text-muted">
                View and manage donations received by the organisation.
            </p>

        </div>

        <a asp-controller="Employee"
           asp-action="Dashboard"
           class="btn btn-outline-success">

            ← Dashboard

        </a>

    </div>


    <div class="card shadow border-0">

        <div class="card-body p-4">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-success">

                        <tr>
                            <th>Donor</th>
                            <th>Email</th>
                            <th>Amount</th>
                            <th>Type</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>

                    </thead>

                    <tbody>

                        <tr>

                            <td>Anonymous</td>

                            <td>Not provided</td>

                            <td class="fw-bold">
                                R250.00
                            </td>

                            <td>
                                One-Time
                            </td>

                            <td>
                                Today
                            </td>

                            <td>
                                <span class="badge bg-success">
                                    Received
                                </span>
                            </td>

                        </tr>


                        <tr>

                            <td>John Smith</td>

                            <td>john@example.com</td>

                            <td class="fw-bold">
                                R1,000.00
                            </td>

                            <td>
                                Recurring
                            </td>

                            <td>
                                Yesterday
                            </td>

                            <td>
                                <span class="badge bg-success">
                                    Received
                                </span>
                            </td>

                        </tr>


                        <tr>

                            <td>Sarah Mokoena</td>

                            <td>sarah@example.com</td>

                            <td class="fw-bold">
                                R500.00
                            </td>

                            <td>
                                One-Time
                            </td>

                            <td>
                                10 Aug 2026
                            </td>

                            <td>
                                <span class="badge bg-success">
                                    Received
                                </span>
                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>